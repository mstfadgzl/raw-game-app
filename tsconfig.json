{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "paths": {
      "@components/*": [
        "./app/components/*"
      ],
      "@services/*": [
        "./app/api/*"
      ],
      "@screens/*": [
        "./app/screens/*"
      ],
      "@assets/*": [
        "./app/assets/*"
      ],
      "@navigators/*": [
        "./app/navigators/*"
      ],
      "@utils/*": [
        "./app/utils/*"
      ],
      "@hooks/*": [
        "./app/hooks/*"
      ],
      "@types": [
        "./app/types"
      ],
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "**/node_modules",
    "**/Pods"
  ]
}