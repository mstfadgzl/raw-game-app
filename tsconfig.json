{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "paths": {
      "@components": [
        "./app/components"
      ],
      "@services": [
        "./app/api"
      ],
      "@screens": [
        "./app/screens"
      ],
      "@assets": [
        "./app/assets"
      ],
      "@navigators": [
        "./app/navigators"
      ],
      "@utils": [
        "./app/utils"
      ],
      "@hooks": [
        "./app/hooks"
      ],
      "@types": [
        "./app/types"
      ],
      "@api": [
        "./app/services"
      ],
      "@theme": [
        "./app/theme"
      ],
      "@redux": [
        "./app/redux"
      ],
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "**/node_modules",
    "**/Pods"
  ]
}